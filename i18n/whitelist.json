{
  "$schema": "AST 抽取白名单：只翻译这里列出的节点类型与属性名",
  "version": 1,

  "jsx": {
    "textNodes": true,

    "attributes": [
      "label",
      "placeholder",
      "title",
      "tooltip",
      "help",
      "helpText",
      "helperText",
      "description",
      "caption",
      "aria-label",
      "aria-description",
      "alt",
      "confirmText",
      "cancelText",
      "submitText",
      "submitButtonText",
      "submitLoadingText",
      "cancelButtonText",
      "buttonText",
      "header",
      "heading",
      "subheader",
      "subtitle",
      "emptyMessage",
      "emptyText",
      "noDataText",
      "loadingText",
      "errorMessage",
      "successMessage",
      "warningMessage",
      "infoMessage",
      "message"
    ]
  },

  "calls": {
    "$schema": "翻译这些函数调用的字符串字面量参数（UI 通知/toast 类）",
    "functions": [
      "UserNotification.success",
      "UserNotification.error",
      "UserNotification.warning",
      "UserNotification.info",
      "toast.success",
      "toast.error",
      "toast.warning",
      "toast.info",
      "notify",
      "alert",
      "confirm"
    ]
  },

  "strings": {
    "$schema": "裸字符串字面量翻译（需配合上下文判断，默认关闭，只在 callsite 白名单里启用）",
    "enableBare": false
  }
}
